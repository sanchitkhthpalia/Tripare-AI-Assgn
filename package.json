{
  "name": "hotel-rate-comparator",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "temporal"
  ],
  "scripts": {
    "build:shared": "npm run build -w packages/shared",
    "build": "npm run build:shared && npm run build -w @hotel-rate-comparator/frontend",
    "dev:frontend": "npm run dev -w @hotel-rate-comparator/frontend",
    "dev:backend": "npm run dev -w @hotel-rate-comparator/backend",
    "dev:worker": "npm run worker -w @hotel-rate-comparator/temporal",
    "dev:temporal": "temporal server start-dev",
    "temporal": "npm run dev:temporal",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:worker\"",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "prettier --check .",
    "test": "vitest run --testTimeout 30000",
    "test:unit": "vitest run tests/unit --testTimeout 30000",
    "test:workflow": "vitest run tests/workflow --testTimeout 30000",
    "test:integration": "vitest run tests/integration --testTimeout 30000",
    "test:watch": "vitest --testTimeout 30000",
    "test:coverage": "vitest run --coverage --testTimeout 30000"
  },
  "devDependencies": {
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/common": "^1.11.0",
    "@temporalio/testing": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.1.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
